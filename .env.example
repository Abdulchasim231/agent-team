# Copy to .env and fill in. Never commit .env.
# Every key is optional: agents use the providers you have keys for and skip the rest.
# With no keys at all, everything runs on LOCAL_MODEL via Ollama.

# Free tiers (no credit card needed at the time of writing; limits change often)
GROQ_API_KEY=          # https://console.groq.com/keys
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys (free "Experiment" plan)
GITHUB_TOKEN=          # https://github.com/settings/tokens (fine-grained, "Models: read")

# openrouter.ai: free ":free" models, or paid models with credits
OPENROUTER_API_KEY=

# Local models via Ollama
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen3:8b
OLLAMA_CONCURRENCY=1

# Optional
# RATE_LIMIT_COOLDOWN=60
# REQUEST_TIMEOUT=120
# AGENTS_FILE=agents.yaml
# WORKSPACE_DIR=workspace
# DB_PATH=data/agent_team.db
# MAX_AGENT_STEPS=10
